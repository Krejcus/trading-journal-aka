{
    "installCommand": "npm ci",
    "crons": [
        {
            "path": "/api/cron/send-alerts",
            "schedule": "* * * * *"
        },
        {
            "path": "/api/cron/weekly-report",
            "schedule": "0 17 * * 0"
        },
        {
            "path": "/api/cron/journal-import",
            "schedule": "* * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/terms",
            "destination": "/terms.html"
        },
        {
            "source": "/oauth/tradovate/callback",
            "destination": "/api/tradovate/oauth/callback"
        },
        {
            "source": "/share/:id",
            "destination": "/api/share/:id"
        },
        {
            "source": "/day/:token",
            "destination": "/api/live-day-share/:token"
        },
        {
            "source": "/day/:token/",
            "destination": "/api/live-day-share/:token"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "functions": {
        "api/cron/journal-import.ts": {
            "maxDuration": 300
        },
        "api/tradovate/oauth/journal-import.ts": {
            "maxDuration": 300
        },
        "api/tradovate/oauth/copier-relay.ts": {
            "regions": [
                "arn1"
            ]
        },
        "api/tradovate/oauth/copier-device.ts": {
            "regions": [
                "arn1"
            ]
        },
        "api/tradovate/oauth/copier-journal.ts": {
            "regions": [
                "arn1"
            ]
        },
        "api/tradovate/oauth/status.ts": {
            "regions": [
                "arn1"
            ]
        },
        "api/tradovate/oauth/journal-sources.ts": {
            "regions": [
                "arn1"
            ]
        },
        "api/tradovate/account-profiles.ts": {
            "regions": [
                "arn1"
            ]
        }
    }
}
