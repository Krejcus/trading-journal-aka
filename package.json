    "lightweight-charts": "5.2.1",
    "lightweight-charts-drawing": "^0.1.1",
    "lucide-react": "^0.555.0",
    "papaparse": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.10",
