{
  "name": "alphatrade-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "VITE_NATIVE_BUILD=true VITE_API_ORIGIN=https://alphatrade-mentor-15.vercel.app VITE_NATIVE_AUTH_REDIRECT=alphatrade-native://auth/callback vite build --mode native && node scripts/ios/verify-native-bundle.mjs",
    "ios:doctor": "node scripts/ios/doctor.mjs",
    "ios:sync": "npm run ios:doctor && npm run build:native && cap sync ios && npm run ios:doctor",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "market-data:estimate-cost": "node scripts/market-data/estimate-backfill-cost.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "copier:pilot": "tsx scripts/copier/pilot.ts",
    "copier:mac": "tsx scripts/copier/mac-install.ts"
  },
  "dependencies": {
