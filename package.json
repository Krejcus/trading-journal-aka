    "@getcandlekit/charts": "0.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/react-grid-layout": "^2.1.0",
    "@types/web-push": "^3.6.4",
    "clsx": "^2.1.1",
    "flexlayout-react": "^0.9.2",
