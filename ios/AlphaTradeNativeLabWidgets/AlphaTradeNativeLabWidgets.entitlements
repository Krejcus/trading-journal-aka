<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Stejně jako u hlavní aplikace: App Group je odebraná kvůli free
      Personal Team podpisu. Snapshot se pak nesdílí a widgety ukazují
      jasně označená testovací data. S placeným účtem vrátit:

      <key>com.apple.security.application-groups</key>
      <array>
          <string>group.app.alphatrade.nativelab</string>
      </array>
    -->
</dict>
</plist>
