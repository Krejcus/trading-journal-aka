{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "alphatrade",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5273,
      "autoPort": true
    },
    {
      "name": "alphatrade-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:live"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "alphatrade-main",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "--prefix",
        "/private/tmp/alphatrade-main-preview",
        "dev:live",
        "--",
        "--port",
        "5274",
        "--strictPort"
      ],
      "port": 5274,
      "autoPort": false
    }
  ]
}
